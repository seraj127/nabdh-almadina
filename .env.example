# ─── Database Configuration ─────────────────────────────────
# For local SQLite development:
DATABASE_URL="file:./dev.db"

# For Supabase PostgreSQL (Production):
# SUPABASE_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Next.js App URL ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── JWT Authentication Secret ──────────────────────────────
# Generate a strong 64-char random hex string for production:
# e.g., openssl rand -hex 32
JWT_SECRET="your-jwt-secret-key-change-in-production-min-32-chars"

# ─── Supabase Client Keys ───────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Mobile App Build Configuration ─────────────────────────
# NEXT_PUBLIC_API_URL="https://nabdalmadina.com"
# BUILD_MOBILE="0"

# ─── Seed-only administrator bootstrap ───────────────────────
# Required only when running the database seed; use a secret manager or shell environment.
SEED_ADMIN_PASSWORD="generate-a-unique-password-at-least-16-chars"

# ─── Authenticated realtime sync service ─────────────────────
# Comma-separated HTTPS origins allowed by Socket.IO.
SYNC_ALLOWED_ORIGINS="https://your-app.example"
# Production must point to the Next.js session endpoint.
SYNC_SESSION_CHECK_URL="https://your-app.example/api/auth/session"
