{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "build": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.postgresql.prisma && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:vercel": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:push:supabase": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:generate:supabase": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun run prisma/seed.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:mobile": "test -n \"$CAPACITOR_SERVER_URL\" || { echo 'CAPACITOR_SERVER_URL is required for build:mobile'; exit 1; }; BUILD_MOBILE=1 next build && mkdir -p out && npx cap sync android",
    "apk:debug": "test -n \"$CAPACITOR_SERVER_URL\" || { echo 'CAPACITOR_SERVER_URL is required for apk:debug'; exit 1; }; BUILD_MOBILE=1 next build && mkdir -p out && npx cap sync android && cd android && ./gradlew assembleDebug",
    "apk:release": "test -n \"$CAPACITOR_SERVER_URL\" || { echo 'CAPACITOR_SERVER_URL is required for apk:release'; exit 1; }; BUILD_MOBILE=1 next build && mkdir -p out && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
