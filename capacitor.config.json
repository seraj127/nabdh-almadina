{
  "appId": "com.nabdalmadina.app",
  "appName": "نبض المدينة",
  "webDir": "out",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#004B63"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#004B63",
      "showSpinner": true,
      "spinnerColor": "#FF6F61",
      "androidScaleType": "CENTER_CROP"
    }
  },
  "android": {
    "backgroundColor": "#004B63",
    "allowMixedContent": true
  }
}
