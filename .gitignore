# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules

# Prisma-generated clients (binary engines) — regenerated via `prisma generate` in build
/src/generated/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and signing material — never commit real values
.env
.env.local
.env.*
!.env.example
*.jks
*.keystore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
server.log

# Skills directory
/skills/

# ─── Project-specific ignores ──────────────────────────────────
# AI agent context files
agent-ctx/

# User uploads
upload/

# Release builds (APK, tar.gz)
releases/
*.apk
*.tar.gz

# The mobile app installer is served from public/ on the live site, so it MUST
# stay in git — otherwise Vercel's git-integration deployments drop it (404).
!public/nabd-al-madina.apk

# Screenshots
screenshot-*.png
*-screenshot.png
home-screen.png
mobile-screenshot.png
splash-screen.png
store-check.png
store-final.png

# Keep package-lock.json committed for reproducible npm/CI installs.

# Expo/RN build artifacts
public/_expo/
public/mobile/
public/assets/

# PID files
*.pid

# Local databases
prisma/dev.db
db/*.db
*.db-journal

# Development notes
worklog.md
AUDIT-REPORT.md
FILES-DETAIL.md
MOBILE_APP_STATE.md
gen-log.txt
.vercel
